{
  "@context": {
    "@version": 1.1,

    "@import": "https://www.w3.org/ns/credentials/v2",

    "mds-credentials": "https://w3id.org/mobility-dataspace/2026/1/credentials/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "MembershipCredential": "mds-credentials:MembershipCredential",
    "GroupMembershipCredential": "mds-credentials:GroupMembershipCredential",

    "active": {
      "@id": "mds-credentials:active",
      "@type": "xsd:boolean"
    },
    "participantId": {
      "@id": "mds-credentials:participantId",
      "@type": "xsd:string"
    },
    "groups": {
      "@id": "mds-credentials:groups",
      "@type": "xsd:string",
      "@container": "@set"
    }
  }
}
